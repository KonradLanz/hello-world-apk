<?xml version='1.0' encoding='utf-8'?>
<widget id="com.konradlanz.helloworld" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Hello World</name>
    <description>Meine erste eigene App, gebaut am Handy.</description>
    <author email="you@example.com" href="https://github.com/KonradLanz/hello-world-apk">Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="33" />
    </platform>
    <preference name="Orientation" value="portrait" />
</widget>
